# ============================================================================
#  FinsROV — 仓库根目录 .gitignore
#  语法速查：
#    /xxx        仅匹配“仓库根目录”下的 xxx
#    xxx/        仅匹配目录
#    **/xxx      匹配任意层级的 xxx
#    !xxx        例外（不要忽略）；写在后面的规则优先级更高
#    #           注释
#  重要：本文件只对“还没有被 Git 跟踪”的文件生效。
#        若某个文件早就被提交过，加多少条规则都无效，必须先
#        git rm --cached <file> 把它从版本库中移除（保留本地文件）。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 操作系统 / OS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp
*.swo

# ---------------------------------------------------------------------------
# 2. 编辑器 / IDE（属于个人环境，每个人不一样，不要提交）
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.code-workspace
.clangd/
.cache/
compile_commands.json

# ---------------------------------------------------------------------------
# 3. Keil MDK-ARM（下位机 STM32 工程）
#    .uvprojx 是工程文件，必须提交；下面这些是个人配置和编译产物。
# ---------------------------------------------------------------------------
*.uvguix.*
*.uvoptx
*.bak
*.crf
*.dep
*.lnp
*.map
*.lst
*.sct
*.htm
*.build_log.htm
*.axf
*.elf
*.hex
*.bin
JLinkLog.txt
JLinkSettings.ini
Objects/
Listings/
DebugConfig/
# Keil 的输出目录与 target 名同名，所以这里显式点名
**/MDK-ARM/RM_Frame_C/

# ---------------------------------------------------------------------------
# 4. 构建系统：CMake / Ninja / GNU 工具链
# ---------------------------------------------------------------------------
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log

# ---------------------------------------------------------------------------
# 5. 通用编译中间产物 / 目标文件
# ---------------------------------------------------------------------------
*.o
*.obj
*.d
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out

# ---------------------------------------------------------------------------
# 6. Python（Code/Joystick_Control 上位机代码）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# 7. 第三方文档：ST 官方 HAL 库手册（*.chm，Windows 帮助文件，约 115MB）
#    编译完全用不到，请从 st.com 按需下载，不要放进仓库。
# ---------------------------------------------------------------------------
*.chm

# ---------------------------------------------------------------------------
# 8. 3D / CAD 临时文件（SolidWorks、Office 会自动生成 ~$ 开头的锁文件）
# ---------------------------------------------------------------------------
~$*.sldprt
~$*.sldasm
~$*.xlsx
*.sldprt~
*.sldasm~
*.tmp

# ---------------------------------------------------------------------------
# 9. 本地临时 / 日志 / 个人资料
# ---------------------------------------------------------------------------
*.log


# ---------------------------------------------------------------------------
# 10. 大文件策略
#    ≥ 50MB 的二进制（*.STEP / *.pdf 等）GitHub 单文件上限 100MB。
#    三维模型（*.STEP / *.stp）已由 Git LFS 接管，见 .gitattributes。
#    以后新增其它大文件，请一并纳入 LFS：
#        git lfs track "Structure/**/*.xlsx"
#        git add .gitattributes
# ---------------------------------------------------------------------------

# else
/tmp/
/Manual/
